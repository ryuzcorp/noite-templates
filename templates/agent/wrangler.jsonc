{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.jsonc",
  // Worker name celld serves the app as.
  "name": "noite-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "AgentSandbox", "class_name": "AgentSandbox" }]
  },
  // SQLite-backed DO: the harness transcript lives in the object's storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentSandbox"] }],
  "containers": [
    {
      "class_name": "AgentSandbox",
      // Stock Sandbox image: it already ships node, git and sh, which is
      // everything the container tools need. Keep the tag on the same
      // release line as the `@cloudflare/sandbox` dependency (0.12.x):
      // the SDK checks version compatibility on startup. `$SANDBOX_IMAGE`
      // at build time overrides this with a custom image (see scripts/build.ts).
      "image": "docker.io/cloudflare/sandbox:0.12.9",
      "instance_type": "basic",
      "max_instances": 4
    }
  ],
  "vars": {
    // Model id for the OpenAI-compatible provider (e.g. "gpt-5-mini"). The
    // exact value "faux" selects pi-ai's faux provider: scripted answers,
    // no credentials.
    "MODEL": "gpt-5-mini",
    // Any OpenAI-compatible chat-completions base URL. The token lives in
    // the secret OPENAI_API_KEY (Noite Settings -> Environment), never here.
    // AI Gateway users point this at
    // https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/openai
    "OPENAI_BASE_URL": "https://api.openai.com/v1"
  }
}
